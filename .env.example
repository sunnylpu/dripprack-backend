# ==============================================================================
# DripRack Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit .env to source control!
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
# Comma-separated list of allowed client origins (Admin Portal: 5173, Customer Storefront: 5174)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:5174
COOKIE_SECRET=change_this_to_a_cryptographically_secure_random_string_in_production
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
# COOKIE_DOMAIN=.yourdomain.com

# MongoDB Database Connection
# E.g. mongodb://127.0.0.1:27017/driprack or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://127.0.0.1:27017/driprack

# JWT Authentication Secrets
# Generate using: openssl rand -base64 48
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_example
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Store Policies & Pricing Defaults (Minor units: cents)
CURRENCY_CODE=USD
TAX_RATE_PERCENT=0
SHIPPING_FLAT_FEE_CENTS=500
FREE_SHIPPING_THRESHOLD_CENTS=5000

# Payments Configuration
# Active provider: cod, stripe, dodo, or mock
ENABLE_ONLINE_PAYMENTS=false
PAYMENT_PROVIDER=cod

# Optional: Stripe Gateway Credentials
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# Optional: Dodo Payments Gateway Credentials
# DODO_PAYMENTS_API_KEY=dodo_test_... or dodo_live_...
# DODO_PAYMENTS_PUBLISHABLE_KEY=pk_snd_... or pk_live_...
# DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# DODO_PAYMENTS_PRODUCT_ID=pdt_...
# DODO_PAYMENTS_ENVIRONMENT=test_mode # or live_mode

# Logging
LOG_LEVEL=info

# Initial Administrator Bootstrap (For scripts/createAdmin.js)
ADMIN_EMAIL=admin@driprack.com
ADMIN_PASSWORD=change_this_to_a_strong_password_with_uppercase_lowercase_number_special
ADMIN_FIRST_NAME=Store
ADMIN_LAST_NAME=Administrator
