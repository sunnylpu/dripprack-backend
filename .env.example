# ==============================================================================
# DripRack Backend Environment Configuration Template
# Copy this file to .env and replace placeholders with your actual values.
# NEVER commit .env to source control!
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Security & CORS
# Comma-separated list of allowed client origins
CORS_ORIGIN=http://localhost:3000,http://localhost:5173
COOKIE_SECRET=change_this_to_a_cryptographically_secure_random_string_in_production

# MongoDB Database Connection
# E.g. mongodb://127.0.0.1:27017/driprack or MongoDB Atlas SRV URI
MONGODB_URI=mongodb://127.0.0.1:27017/driprack

# JWT Authentication Secrets
# Generate using: openssl rand -base64 48
JWT_ACCESS_SECRET=your_jwt_access_secret_minimum_32_characters_long_example
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_jwt_refresh_secret_minimum_32_characters_long_example
JWT_REFRESH_EXPIRES_IN_DAYS=7

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX_REQUESTS=5

# Store Policies & Pricing Defaults (Minor units: cents)
CURRENCY_CODE=USD
TAX_RATE_PERCENT=0
SHIPPING_FLAT_FEE_CENTS=500
FREE_SHIPPING_THRESHOLD_CENTS=5000

# Logging
LOG_LEVEL=info
